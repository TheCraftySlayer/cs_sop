Pr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Department: Customer Service</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4680"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:shd w:fill="E7E6E6" w:color="auto" w:val="clear"/><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">SOP ID: CS08</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4680"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:shd w:fill="E7E6E6" w:color="auto" w:val="clear"/><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Last Reviewed: 05/05/2026</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4680"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:shd w:fill="E7E6E6" w:color="auto" w:val="clear"/><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Effective Date: 05/05/2026</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="4680"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:shd w:fill="E7E6E6" w:color="auto" w:val="clear"/><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Version: 1</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Purpose</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">This SOP outlines the standardized process for adding custom inbound routing rules to a user&apos;s direct phone number (DID). The most common use case at the Assessor&apos;s Office is redirecting a switchboard agent&apos;s DID into the switchboard queue itself, so callers who dial the agent directly are still subject to queue distribution rather than ringing only the named agent.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Scope</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Applies to custom inbound rules configured on user extensions (Users → [user] → Call Handling → Custom rules). Queue-level custom rules are out of scope (see CS05).</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Authorization</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">All DID redirect rules require Deputy Assessor authorization. These rules change where calls to a specific public number land and can confuse callers if applied without coordination.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Definitions</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">DID (Direct Inward Dial) – A direct phone number assigned to an individual user or extension.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Custom inbound rule – A condition-based override on a user extension that redirects matching inbound calls to a different destination. User-level custom rules use the same condition and action types as queue-level rules (see CS05) but apply to a single user&apos;s incoming traffic.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Called Number condition – The rule condition that matches when a caller dials a specific number. This is the condition that turns a generic user-level custom rule into a DID-specific redirect rule. Without this condition, the rule applies to every call reaching the user (including queue calls and internal extension dials), which is almost never the intent.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Forward to extension – The rule action used to send a matching call to a queue (e.g., 160001) rather than ringing the user&apos;s devices.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Route Inbound to Switchboard – The standard rule-naming pattern at the Assessor&apos;s Office for DID redirects: a Called Number condition (the user&apos;s DID) combined with a Forward to extension action (the switchboard queue, 160001).</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Prerequisites</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">This SOP assumes the operator is signed in to the RingCentral Admin Portal and can navigate to a specific call queue. For sign-in and navigation instructions, see CS02 (RingCentral Admin Portal Reference).</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">The operator must have appropriate manager access to the queue being modified — see Authorization below.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Related Documents</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">RingCentral Admin Portal: </w:t></w:r><w:hyperlink w:history="1" r:id="rIdiuzmx8v7aj9svfttae5gp"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr><w:t xml:space="preserve">https://service.ringcentral.com</w:t></w:r></w:hyperlink></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">RingCentral Custom Answering Rules — official setup guide: </w:t></w:r><w:hyperlink w:history="1" r:id="rIdkgzfdhwggm8oo6voz1qof"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr><w:t xml:space="preserve">https://support.ringcentral.com/content/dam/support/us/en/pdf/get-started/v2/RCA_Setting_Up_Custom_Answering_Rules_For_Your_Extension.pdf</w:t></w:r></w:hyperlink></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">RingCentral Call Queue Call Handling — developer documentation: </w:t></w:r><w:hyperlink w:history="1" r:id="rIdv_ej3hneuvgpxuyrf050g"><w:r><w:rPr><w:rStyle w:val="Hyperlink"/></w:rPr><w:t xml:space="preserve">https://developers.ringcentral.com/guide/voice/call-routing/manual/callqueue-answering-rules</w:t></w:r></w:hyperlink></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">CS02 — RingCentral Admin Portal Reference</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">CS05 — Holiday and Custom Rules (queue-level custom rules — different object, same UI concept and condition/action types)</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">RingCentral Custom Answering Rules support documentation: https://support.ringcentral.com/content/dam/support/us/en/pdf/get-started/v2/RCA_Setting_Up_Custom_Answering_Rules_For_Your_Extension.pdf</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Queue Change Log — RingCentral configuration history (maintained in shared drive)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="140" w:before="280"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">Reference Patterns</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Established DID redirect rules at the Assessor&apos;s Office (as of last review):</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Diana Y Martinez (ext 163722) </w:t></w:r><w:r><w:t xml:space="preserve">— DID 505-222-3722. Custom rule &quot;Route Inbound to Switchboard&quot; redirects inbound calls to Q1 (160001).</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="40" w:before="40"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Melissa Vigil (ext 169005) </w:t></w:r><w:r><w:t xml:space="preserve">— DID 505-468-7243. Custom rule &quot;Route Inbound to Switchboard&quot; redirects inbound calls to Q1 (160001).</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Both rules were established 03/22/2026 to collapse a two-pathway architecture in which calls dialed directly to switchboard agents bypassed queue routing and contributed to a higher direct-dial failure rate.</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="140" w:before="280"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">Adding a DID Redirect Rule</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Note: this section describes the procedure based on the standard RingCentral user-extension Custom rules workflow as documented by RingCentral. Screenshots of the user-side Custom rules tab are not yet captured at the Assessor&apos;s Office. Send screenshots when the next rule is configured and this section will be expanded with images.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">RingCentral has been changing the admin-portal UI labels over time. Older versions used &quot;Call Handling &amp; Forwarding&quot;; newer versions use &quot;Call Handling&quot; or &quot;Incoming Call Rules.&quot; The procedure below describes the conceptual flow; the exact labels in the current portal version may differ slightly.</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:type="dxa" w:w="9360"/><w:tblBorders><w:top w:val="single" w:color="auto" w:sz="4"/><w:left w:val="single" w:color="auto" w:sz="4"/><w:bottom w:val="single" w:color="auto" w:sz="4"/><w:right w:val="single" w:color="auto" w:sz="4"/><w:insideH w:val="single" w:color="auto" w:sz="4"/><w:insideV w:val="single" w:color="auto" w:sz="4"/></w:tblBorders></w:tblPr><w:tblGrid><w:gridCol w:w="9360"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="9360"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Navigate to the user&apos;s extension</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">From the top navigation: Users → Users with Extensions.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Search for the user by name or extension.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Click the user to open their extension panel.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="9360"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Open the user&apos;s Custom rules tab</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">In the user panel, navigate to Call Handling (also labeled Call Handling &amp; Forwarding or Incoming Call Rules in some portal versions).</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Click the Custom rules tab.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="9360"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Add the rule</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Click + Add Rule.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Enter the rule name. The Assessor&apos;s Office convention is &quot;Route Inbound to Switchboard&quot;.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Click Next.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="9360"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Configure the Called Number condition</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Select Called Number as the condition type. This is the critical step — it scopes the rule to apply only when callers dial the user&apos;s DID, not when they reach the user through internal calls or queue routing.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Select the user&apos;s DID from the dropdown (e.g., 505-222-3722 for Diana Y Martinez).</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Do not add a Date/Time condition unless the redirect should be time-bounded. Leave Caller ID unset to apply to all incoming callers.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Click Next.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="9360"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Configure the Forward to extension action</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Select Forward calls as the action.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Choose to forward to an extension on the account.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Select the queue&apos;s full extension number (e.g., 160001 for Assessor&apos;s Office).</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">CRITICAL: forward to the queue&apos;s EXTENSION, not its phone number. RingCentral rejects forwarding rules that target a phone number already on the account, with the error &quot;Forwarding phone number cannot be the same as your account number or any additional numbers.&quot; This is documented behavior, not a bug.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Click Save.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="9360"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Verify</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Place a test call from an outside line to the user&apos;s DID.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">The call should ring into the queue rather than to the user directly. In the queue&apos;s call log, the call should appear with the dialed number recorded as the user&apos;s DID and the routed destination as the queue extension.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Place a separate test by calling the user&apos;s extension internally — internal extension dials should still ring the user directly, since the Called Number condition does not match for internal calls.</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="140" w:before="280"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">Removing or Disabling a DID Redirect Rule</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:type="dxa" w:w="9360"/><w:tblBorders><w:top w:val="single" w:color="auto" w:sz="4"/><w:left w:val="single" w:color="auto" w:sz="4"/><w:bottom w:val="single" w:color="auto" w:sz="4"/><w:right w:val="single" w:color="auto" w:sz="4"/><w:insideH w:val="single" w:color="auto" w:sz="4"/><w:insideV w:val="single" w:color="auto" w:sz="4"/></w:tblBorders></w:tblPr><w:tblGrid><w:gridCol w:w="9360"/></w:tblGrid><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="9360"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Disable a rule</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">In the user&apos;s Custom rules list, locate the rule.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Toggle the Active switch to OFF.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Save. The rule is preserved but no longer applies — calls to the DID will route to the user directly per their default call handling.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="9360"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Delete a rule</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Click Delete next to the rule.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Confirm. The rule is removed permanently.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:type="dxa" w:w="9360"/><w:tcBorders><w:top w:val="single" w:color="999999" w:sz="4"/><w:left w:val="single" w:color="999999" w:sz="4"/><w:bottom w:val="single" w:color="999999" w:sz="4"/><w:right w:val="single" w:color="999999" w:sz="4"/></w:tcBorders><w:tcMar><w:top w:type="dxa" w:w="100"/><w:left w:type="dxa" w:w="140"/><w:bottom w:type="dxa" w:w="100"/><w:right w:type="dxa" w:w="140"/></w:tcMar></w:tcPr><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:t xml:space="preserve">Verify</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">Place a test call to the user&apos;s DID and confirm the call now reaches the user (or the user&apos;s default routing) rather than the queue.</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p><w:pPr><w:pStyle w:val="Heading1"/><w:spacing w:after="140" w:before="280"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="32"/><w:szCs w:val="32"/></w:rPr><w:t xml:space="preserve">Change Control</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60" w:before="60"/></w:pPr><w:r><w:t xml:space="preserve">All changes covered by this SOP must be authorized, snapshotted, applied, verified, and logged.</w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:type="dxa" w:w="9360"/><w:tblBorder